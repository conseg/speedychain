FROM --platform=linux/amd64 python:2.7-slim

# Debian Buster (EOL) — use archive mirrors so apt still works
RUN echo 'Acquire::Check-Valid-Until "false";' > /etc/apt/apt.conf.d/99no-check-valid-until && \
    sed -i 's/deb.debian.org/archive.debian.org/g' /etc/apt/sources.list && \
    sed -i 's|security.debian.org|archive.debian.org|g' /etc/apt/sources.list && \
    sed -i '/buster-updates/d' /etc/apt/sources.list && \
    apt-get update && \
    apt-get install -y gcc g++ make libffi-dev libssl-dev && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app/API
COPY API/ .

COPY docker/requirements-device.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

COPY docker/device-entrypoint.sh /usr/local/bin/device-entrypoint.sh
RUN chmod +x /usr/local/bin/device-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/device-entrypoint.sh"]
